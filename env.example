# ==============================================================================
# Attendance & Field Operations - Environment Configuration Template
# Copy this file to .env (server) and set appropriate production values.
# ==============================================================================

# Database Connection (MySQL / Google Cloud SQL)
DATABASE_URL="mysql://dbuser:securepassword@127.0.0.1:3306/attendance_db"
DATABASE_SSL="false"

# Authentication & Security Secrets
JWT_SECRET="replace_with_a_cryptographically_secure_random_string_min_32_chars"
ALLOWED_ORIGINS="https://yourdomain.com,https://api.yourdomain.com"
SUPER_ADMIN_PHONE="+919835916278"

# Firebase Cloud Messaging & Service Account
# Absolute path or relative path to the Firebase Service Account JSON credentials
FIREBASE_SERVICE_ACCOUNT="./firebase-service-account.json"

# Server Network & Storage
PORT="3000"
UPLOADS_DIR="./uploads/selfies"

# Geofence & Location Enforcement Parameters
OFFICE_LAT="28.6139"
OFFICE_LNG="77.2090"
OFFICE_RADIUS_METERS="150"
MAX_GPS_ACCURACY_METERS="100"
DEFAULT_GEOFENCE_RADIUS_METERS="100"

# Client (Mobile Expo & Web Frontend)
# Note: For mobile client builds, configure this in eas.json or .env.local
EXPO_PUBLIC_API_BASE_URL="https://api.yourdomain.com"
